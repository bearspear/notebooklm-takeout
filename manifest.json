{
  "manifest_version": 3,
  "name": "NotebookLM Takeout",
  "version": "1.4.0",
  "description": "Export audio, slides, infographics, notes, and sources from NotebookLM",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*",
    "https://contribution.usercontent.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.scf.usercontent.goog/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "takeout-shared.js",
        "mindmap-extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "takeout-shared.js",
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
